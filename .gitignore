# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# =============================================================================
# Generated pipeline outputs (large video files — do NOT commit)
# =============================================================================
output/
*.mp4
*.avi
*.mkv

# =============================================================================
# Model weights (downloadable on first run — ~6 MB, regenerable)
# =============================================================================
models/*.pt

# =============================================================================
# Datasets (large — keep out of git)
# =============================================================================
data/

# =============================================================================
# Logs (regenerated each run; keep the schema in code, not the data)
# =============================================================================
logs/*.csv

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# Annotation clip package (large media; regenerate with eval/generate_clip_package.py)
eval/clip_package/clips/
eval/clip_package.zip

# LaTeX build files
*.aux
*.log
*.nav
*.out
*.snm
*.toc

# Images/video of real people's faces (the repo is public; keep these local)
eval/annotation_package/frames/
eval/annotation_package/form_build/frames_small/
eval/annotation_package.zip
eval/track_samples/
*.pdf

# Local Claude Code settings
.claude/settings.local.json
.claude/

# Exported detector models (regenerate with Ultralytics export)
models/exported/
